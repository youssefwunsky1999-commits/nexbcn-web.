# ─────────────────────────────────────────────────────────────
# NEXBCN — Variables de entorno
# Copia este archivo a .env.local y rellena los valores reales.
# Mientras falten, la web muestra placeholders claramente marcados.
# ─────────────────────────────────────────────────────────────

# URL pública (sin barra final). Se usa en canonical, sitemap, OG y Schema.org
NEXT_PUBLIC_SITE_URL=https://nexbcn.es

# Datos de contacto (formato internacional, sin espacios: +34600000000)
NEXT_PUBLIC_PHONE=+34611072741
NEXT_PUBLIC_WHATSAPP=+34611072741
NEXT_PUBLIC_EMAIL=multiserviciosbarcelona99@gmail.com

# Dirección fiscal / de la oficina (opcional; si se deja vacía no se muestra)
NEXT_PUBLIC_STREET=
NEXT_PUBLIC_POSTAL_CODE=
NEXT_PUBLIC_CITY=Granollers

# Envío del formulario de presupuesto (https://resend.com)
# Sin estas tres variables el formulario NO envía y lo indica al usuario.
RESEND_API_KEY=
QUOTE_TO_EMAIL=multiserviciosbarcelona99@gmail.com
QUOTE_FROM_EMAIL=
